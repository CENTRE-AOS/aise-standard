{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aise://protocols/asset/schema.json",
  "title": "AISE Asset Protocol Schema",
  "description": "Defines the structure and ownership of project assets shared by all agents.",
  "type": "object",
  "required": ["project_root", "assets"],
  "properties": {
    "project_root": {
      "type": "string",
      "const": ".project",
      "description": "Root directory for project assets."
    },
    "assets": {
      "type": "object",
      "required": ["memory", "context"],
      "properties": {
        "memory": {
          "type": "object",
          "properties": {
            "knowledge": { "type": "string", "const": ".project/memory/knowledge" },
            "decisions": { "type": "string", "const": ".project/decisions" },
            "architecture": { "type": "string", "const": ".project/architecture" },
            "patterns": { "type": "string", "const": ".project/memory/patterns" },
            "glossary": { "type": "string", "const": ".project/memory/glossary" }
          }
        },
        "context": {
          "type": "object",
          "properties": {
            "state": { "type": "string", "const": ".project/context/state.json" },
            "mission": { "type": "string", "const": ".project/context/mission.json" },
            "timeline": { "type": "string", "const": ".project/context/timeline.jsonl" }
          }
        },
        "blueprint": { "type": "string", "const": "PROJECT_BLUEPRINT.md" },
        "changelog": { "type": "string", "const": "CHANGELOG.md" }
      }
    }
  }
}
