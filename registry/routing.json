{
    "aise_version": "2.0.0",
    "schema_version": "1",
    "routes": {
        "archive": {
            "trigger": ["存档", "存档并push"],
            "skill": "archive",
            "description": "存档并推送"
        },
        "handoff": {
            "trigger": ["移交", "接替"],
            "skill": "handoff",
            "description": "Agent 交接"
        },
        "gitops": {
            "trigger": ["新建项目"],
            "skill": "gitops",
            "description": "新建项目初始化"
        },
        "review": {
            "trigger": ["审查", "review", "检查"],
            "skill": "review",
            "description": "代码审查"
        },
        "publish": {
            "trigger": ["发布", "Publish"],
            "skill": "publish",
            "description": "发布版本"
        },
        "sync": {
            "trigger": ["同步", "更新"],
            "skill": "sync",
            "description": "同步环境"
        },
        "fetch": {
            "trigger": ["拉取最新", "Fetch"],
            "skill": "fetch",
            "description": "拉取最新版本"
        },
        "git-gate": {
            "trigger": ["aise fetch", "aise update", "aise sync", "aise verify"],
            "skill": "git-gate",
            "description": "Git 安全操作（使用 AISE commands 替代直接 git pull）"
        },
        "verify": {
            "route": "verify",
            "triggers": ["验证", "verify", "检查合规"],
            "skill": "verify",
            "description": "AISE 合规验证"
        }
    }
}